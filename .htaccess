<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la petición ya incluye la carpeta /public/, no intervenir
    RewriteCond %{REQUEST_URI} ^.*/public(/.*)?$ [NC]
    RewriteRule ^ - [L]

    # Proteger carpetas sensibles y archivos privados de acceso directo por HTTP
    RewriteRule ^(app|config|core|storage)(\/|$) - [F,L,NC]
    RewriteRule \.(sql|env|ini|log|sh)$ - [F,L,NC]

    # Si intentan acceder a una carpeta o archivo real en la raíz (que no sea sensible), que acceda normal
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redirecciona internamente a index.php pasando la ruta para que PHP haga la redirección relativa limpia
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>