# Ignorar los respaldos de la base de datos generados por la app pero mantener la carpeta
storage/backups/*
!storage/backups/.gitkeep
*.sql
!storage/schema.sql
!storage/migrations/
!storage/migrations/*.sql

# Ignorar archivos subidos pero mantener las carpetas y reglas de seguridad
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess
!public/uploads/payment_receipts/
public/uploads/payment_receipts/*
!public/uploads/payment_receipts/.gitkeep

# Configuraciones locales y variables de entorno
config/database.local.php
config/ai.local.php
.env

# Android Build Outputs and Caches
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/.cxx/
