<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si intentan acceder a un archivo o carpeta real en public/ (css, assets, uploads, etc.), acceder directo
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redirecciona cualquier otra ruta a index.php pasando la ruta como variable
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
